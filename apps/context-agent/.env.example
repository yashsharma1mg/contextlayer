# Postgres connection string (Supabase project's pooled connection string, pgvector extension enabled)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
STUDIO_URL=http://localhost:3000
# Required in production. Use a distinct high-entropy value from Better Auth.
CONNECTION_ENCRYPTION_KEY=
CONNECTOR_POLLING=false
CONNECTOR_POLL_MINUTES=15
MODEL_CONCURRENCY=2
BACKGROUND_WORKER=true
CONTEXT_LAYER_DATA_DIR=
OUTBOUND_MCP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Models
#
# Chat and embeddings each pick a provider independently. Selection order is:
# the explicit CHAT_PROVIDER / EMBED_PROVIDER, then local, then the cloud
# providers in the order listed below. The LOCAL_* base URLs have no default,
# so leaving them unset keeps an existing cloud setup working unchanged.
#
# Set these to force a provider instead of relying on the order.
#   CHAT_PROVIDER   = local | anthropic | openai | openrouter
#   EMBED_PROVIDER  = local | nvidia | openai
CHAT_PROVIDER=
EMBED_PROVIDER=

# Retried once on failure, on the same provider (a model slug only means
# something to the provider it came from).
CHAT_FALLBACK_MODEL=

# Local — anything speaking the OpenAI wire format (Ollama, opencode,
# llama.cpp, LM Studio). Nothing leaves the machine, so no consent is required.
# Ollama's OpenAI-compatible endpoint is http://localhost:11434/v1
LOCAL_CHAT_BASE_URL=
LOCAL_CHAT_MODEL=qwen2.5-coder
LOCAL_CHAT_API_KEY=
LOCAL_EMBED_BASE_URL=
# Must emit 1024 dimensions to match vector(1024). mxbai-embed-large does;
# nomic-embed-text (768) does not.
LOCAL_EMBED_MODEL=mxbai-embed-large
LOCAL_EMBED_API_KEY=

# Anthropic — an API key OR an OAuth access token, never both. The OAuth path
# sends Authorization: Bearer plus the oauth beta header instead of x-api-key.
# `ant auth login` stores a profile; `ant auth print-credentials --access-token`
# prints a token for ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_CHAT_MODEL=claude-opus-5

# OpenAI — chat and, optionally, embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.2
# Requested at 1024 dimensions to match the column.
OPENAI_EMBED_MODEL=text-embedding-3-large

# OpenRouter — verify slugs at openrouter.ai/models; free tiers get retired.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# NVIDIA NIM embeddings (build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Image description and transcription still route through OpenRouter directly.
VISION_MODEL=openai/gpt-4.1-mini
TRANSCRIPTION_MODEL=openai/whisper-1

# Confluence OAuth (2.0, 3LO) — from the Atlassian Developer Console
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=http://localhost:8787/api/connections/confluence/callback

# Figma OAuth — from figma.com/developers/apps
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:8787/api/connections/figma/callback

# Additional read-only knowledge connectors. Callback URLs are derived from
# BETTER_AUTH_URL as /api/connections/<provider>/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Desktop/bundled runtime overrides. The desktop shell supplies these.
AUTO_MIGRATE=false
MIGRATIONS_DIR=
PG_DUMP_PATH=
MEDIA_EXTRACTOR_PATH=
PROTOTYPE_COMPILER_PATH=
